import tkinter as tk
from tkinter import messagebox
import json
import os

# -------------------------------
# Task Checker - Python Project
# -------------------------------

FILE_NAME = "tasks.json"
tasks = []

# Load saved tasks
def load_tasks():
    global tasks
    if os.path.exists(FILE_NAME):
        try:
            with open(FILE_NAME, "r") as file:
                tasks = json.load(file)
        except (json.JSONDecodeError, OSError):
            tasks = []

# Save tasks
def save_tasks():
    with open(FILE_NAME, "w") as file:
        json.dump(tasks, file, indent=4)

# Update task list
def refresh_tasks():
    task_list.delete(0, tk.END)

    for task in tasks:
        status = "✓" if task["completed"] else "○"
        task_list.insert(
            tk.END, f"{status}  {task['name']}"
        )

    update_stats()

# Add a new task
def add_task():
    name = task_entry.get().strip()

    if not name:
        messagebox.showwarning(
            "Empty Task", "Please enter a task!"
        )
        return

    tasks.append({
        "name": name,
        "completed": False
    })

    task_entry.delete(0, tk.END)
    save_tasks()
    refresh_tasks()

# Mark task as completed
def complete_task():
    selected = task_list.curselection()

    if not selected:
        messagebox.showwarning(
            "No Selection", "Select a task first!"
        )
        return

    index = selected[0]
    tasks[index]["completed"] = not tasks[index]["completed"]

    save_tasks()
    refresh_tasks()

# Delete selected task
def delete_task():
    selected = task_list.curselection()

    if not selected:
        messagebox.showwarning(
            "No Selection", "Select a task to delete!"
        )
        return

    index = selected[0]
    del tasks[index]

    save_tasks()
    refresh_tasks()

# Update statistics
def update_stats():
    total = len(tasks)
    completed = sum(
        1 for task in tasks if task["completed"]
    )
    pending = total - completed

    stats_label.config(
        text=f"Total: {total}     "
             f"Completed: {completed}     "
             f"Pending: {pending}"
    )

